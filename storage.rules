rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Media library uploads - allow authenticated admin users to upload
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Doctor/provider profile images
    match /doctor-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Provider images
    match /providers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // General uploads
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
